# BDA Sécurité & VTC Premium — réglages du serveur (hébergement OVH)

# Encodage des pages
AddDefaultCharset UTF-8

# Fiche contact (carte de visite digitale) : ouverte directement par le téléphone
<IfModule mod_mime.c>
  AddType text/vcard .vcf
  AddCharset UTF-8 .vcf
  AddType application/manifest+json .webmanifest
</IfModule>

# Adresse unique et sécurisée : tout est redirigé vers https://bdasecurite.com
RewriteEngine On
RewriteCond %{HTTP_HOST} !^bdasecurite\.com$ [NC,OR]
RewriteCond %{SERVER_PORT} 80
RewriteRule ^(.*)$ https://bdasecurite.com/$1 [R=301,L]

# Adresses propres, sans « .html » (ex. https://bdasecurite.com/devis)
# 1. /index.html ou /index -> page d'accueil
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/+index(\.html)?[\s?] [NC]
RewriteRule ^ https://bdasecurite.com/ [R=301,L]
# 2. /page.html -> /page (anciens liens et Google redirigés définitivement)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/+([^\s?]+?)\.html[\s?] [NC]
RewriteRule ^ https://bdasecurite.com/%1 [R=301,L]
# 3. /page/ -> /page (d'après l'adresse tapée : OVH retrouve déjà seul page.html)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/+([^\s?]+?)/+[\s?]
RewriteRule ^ https://bdasecurite.com/%1 [R=301,L]
# 4. /page -> affiche le fichier page.html, sans le montrer dans l'adresse
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [L]

# Pas d'affichage de la liste des fichiers d'un dossier
Options -Indexes

# Fichiers internes non accessibles depuis le web (guide, script Google, historique Git)
<FilesMatch "\.(md|gs)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git

# Compression des pages, styles et scripts (chargement plus rapide)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/xml text/plain
</IfModule>

# Images gardées en mémoire par le navigateur pendant 1 mois (pages plus rapides, mieux notées par Google)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
